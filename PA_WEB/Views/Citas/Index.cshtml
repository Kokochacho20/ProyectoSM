@model List<PA_WEB.Models.CitaModel>

@{
    ViewData["Title"] = "Mis citas";
}

<section class="py-5">
    <div class="container">

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
            <div>
                <h3 class="clinic-title mb-1">Mis citas</h3>
                <p class="clinic-subtitle mb-0">
                    Consulte, modifique o cancele sus citas médicas registradas.
                </p>
            </div>

            <a asp-controller="Home" asp-action="Inicio" class="btn btn-primary">
                Agendar nueva cita
            </a>
        </div>

        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-info shadow-sm" role="alert">
                @TempData["Mensaje"]
            </div>
        }

        @if (!Model.Any())
        {
            <div class="clinic-empty-state">
                <h5 class="mb-2">Aún no tiene citas registradas</h5>
                <p class="mb-3">Cuando solicite una cita, aparecerá en esta sección.</p>

                <a asp-controller="Home" asp-action="Inicio" class="btn btn-primary">
                    Agendar cita
                </a>
            </div>
        }
        else
        {
            <div class="clinic-table-card">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Profesional</th>
                                <th>Fecha y hora</th>
                                <th>Estado</th>
                                <th>Motivo</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var cita in Model)
                            {
                                @if (cita.FechaHoraInicio <= DateTime.Now)
                                {
                                    cita.EstadoCita = EstadoCitaModel.Finalizada;
                                }

                                var badge = cita.EstadoCita switch
                                {
                                    PA_WEB.Models.EstadoCitaModel.Pendiente => "warning",
                                    PA_WEB.Models.EstadoCitaModel.Confirmada => "success",
                                    PA_WEB.Models.EstadoCitaModel.Cancelada => "secondary",
                                    _ => "dark"
                                };

                                <tr>
                                    <td class="fw-semibold">@cita.ProfesionalMedico</td>

                                    <td>
                                        @cita.FechaHoraInicio.ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td>
                                        <span class="badge bg-@badge">
                                            @cita.EstadoCita
                                        </span>
                                    </td>

                                    <td>@cita.Motivo</td>

                                    <td class="text-end">
                                        @if (cita.EstadoCita == PA_WEB.Models.EstadoCitaModel.Pendiente ||
                                             cita.EstadoCita == PA_WEB.Models.EstadoCitaModel.Confirmada)
                                        {
                                            <a class="btn btn-sm btn-outline-primary mb-1"
                                               asp-action="Calendario"
                                               asp-controller="Profesionales"
                                               asp-route-citaId="@cita.Id">
                                                Modificar
                                            </a>

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger mb-1"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modalCancelar"
                                                    data-cita-id="@cita.Id"
                                                    data-profesional="@cita.ProfesionalMedico">
                                                Cancelar
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <div class="modal fade"
                         id="modalCancelar"
                         tabindex="-1"
                         aria-labelledby="modalCancelarLabel"
                         aria-hidden="true">

                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content">

                                <div class="modal-header">
                                    <h5 class="modal-title" id="modalCancelarLabel">
                                        Cancelar cita
                                    </h5>

                                    <button type="button"
                                            class="btn-close"
                                            data-bs-dismiss="modal"
                                            aria-label="Cerrar">
                                    </button>
                                </div>

                                <div class="modal-body">
                                    ¿Seguro que desea cancelar esta cita con
                                    <strong id="modalProfesional"></strong>?
                                </div>

                                <div class="modal-footer">

                                    <button type="button"
                                            class="btn btn-outline-secondary"
                                            data-bs-dismiss="modal">
                                        Volver
                                    </button>

                                    <form method="post"
                                          asp-action="Cancelar"
                                          id="formCancelar">

                                        <input type="hidden"
                                               name="citaId"
                                               id="modalCitaId" />

                                        <button type="submit"
                                                class="btn btn-danger">
                                            Sí, cancelar
                                        </button>

                                    </form>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

    </div>
</section>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const modal = document.getElementById("modalCancelar");

        modal.addEventListener("show.bs.modal", function (event) {

            const button = event.relatedTarget;

            const citaId = button.getAttribute("data-cita-id");
            const profesional = button.getAttribute("data-profesional");

            document.getElementById("modalCitaId").value = citaId;
            document.getElementById("modalProfesional").textContent = profesional;

            console.log("Cita a cancelar:", citaId);
        });

    });
</script>