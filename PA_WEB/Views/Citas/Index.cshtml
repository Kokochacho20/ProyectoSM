@model List<PA_WEB.Models.CitaModel>

@{
    ViewData["Title"] = "Mis citas";
}

<section class="py-5">
    <div class="container">

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
            <div>
                <h3 class="clinic-title mb-1">Mis citas</h3>
                <p class="clinic-subtitle mb-0">
                    Consulte, modifique o cancele sus citas médicas registradas.
                </p>
            </div>

            <a asp-controller="Home" asp-action="Inicio" class="btn btn-primary">
                Agendar nueva cita
            </a>
        </div>

        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-info shadow-sm" role="alert">
                @TempData["Mensaje"]
            </div>
        }

        @if (!Model.Any())
        {
            <div class="clinic-empty-state">
                <h5 class="mb-2">Aún no tiene citas registradas</h5>
                <p class="mb-3">Cuando solicite una cita, aparecerá en esta sección.</p>

                <a asp-controller="Home" asp-action="Inicio" class="btn btn-primary">
                    Agendar cita
                </a>
            </div>
        }
        else
        {
            <div class="clinic-table-card">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Profesional</th>
                                <th>Fecha y hora</th>
                                <th>Estado</th>
                                <th>Motivo</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var cita in Model)
                            {
                                var badge = cita.EstadoCita switch
                                {
                                    PA_WEB.Models.EstadoCitaModel.Pendiente => "warning",
                                    PA_WEB.Models.EstadoCitaModel.Confirmada => "success",
                                    PA_WEB.Models.EstadoCitaModel.Cancelada => "secondary",
                                    _ => "dark"
                                };

                                <tr>
                                    <td class="fw-semibold">@cita.ProfesionalMedico</td>
                                    <td>@cita.FechaHoraInicio.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        <span class="badge bg-@badge">
                                            @cita.EstadoCita
                                        </span>
                                    </td>
                                    <td>@cita.Motivo</td>
                                    <td class="text-end">
                                        @if (cita.EstadoCita == PA_WEB.Models.EstadoCitaModel.Pendiente ||
                                             cita.EstadoCita == PA_WEB.Models.EstadoCitaModel.Confirmada)
                                        {
                                            <a class="btn btn-sm btn-outline-primary"
                                               asp-action="Modificar"
                                               asp-route-citaId="@cita.Id">
                                                Modificar
                                            </a>

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modalCancelar@cita.Id">
                                                Cancelar
                                            </button>
                                        }
                                    </td>
                                </tr>

                                <div class="modal fade" id="modalCancelar@cita.Id" tabindex="-1" aria-labelledby="modalCancelarLabel@cita.Id" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title" id="modalCancelarLabel@cita.Id">
                                                    Cancelar cita
                                                </h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                                            </div>

                                            <div class="modal-body">
                                                ¿Seguro que desea cancelar esta cita con <strong>@cita.ProfesionalMedico</strong>?
                                            </div>

                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                                                    Volver
                                                </button>

                                                <form method="post" asp-action="Cancelar" asp-route-citaId="@cita.Id">
                                                    <button type="submit" class="btn btn-danger">
                                                        Sí, cancelar
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

    </div>
</section>