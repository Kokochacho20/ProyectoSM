@model List<PA_WEB.Models.NotificacionModel>

@{
    ViewData["Title"] = "Notificaciones";

    var soloPendientes = ViewBag.SoloPendientes as bool? ?? false;
}

<section class="py-4">
    <div class="container-fluid">

        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
            <div>
                <span class="home-section-badge">
                    <i class="bx bx-bell"></i>
                    Notificaciones
                </span>

                <h3 class="clinic-title mb-1">Centro de notificaciones</h3>

                <p class="clinic-subtitle mb-0">
                    Revise avisos relacionados con citas, aprobaciones, cancelaciones y cambios importantes.
                </p>
            </div>

            <div class="d-flex gap-2">
                @if (soloPendientes)
                {
                    <a asp-controller="Notificaciones" asp-action="Index" class="btn btn-outline-secondary">
                        Ver todas
                    </a>
                }
                else
                {
                    <a asp-controller="Notificaciones" asp-action="Index" asp-route-soloPendientes="true" class="btn btn-outline-primary">
                        Solo pendientes
                    </a>
                }

                <form method="post" asp-controller="Notificaciones" asp-action="MarcarTodasLeidas">
                    <button type="submit" class="btn btn-primary">
                        Marcar todas como leídas
                    </button>
                </form>
            </div>
        </div>

        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-info shadow-sm">
                @TempData["Mensaje"]
            </div>
        }

        @if (ViewBag.Mensaje != null)
        {
            <div class="alert alert-danger shadow-sm">
                @ViewBag.Mensaje
            </div>
        }

        <div class="row g-4 mb-4">
            <div class="col-md-4">
                <div class="clinic-info-box h-100">
                    <small class="opacity-75">Total mostrado</small>
                    <h3 class="text-white mb-0">@Model.Count</h3>
                </div>
            </div>

            <div class="col-md-4">
                <div class="clinic-card-soft p-4 h-100">
                    <small class="text-muted">Pendientes</small>
                    <h3 class="clinic-title mb-0">@Model.Count(x => !x.Leida)</h3>
                </div>
            </div>

            <div class="col-md-4">
                <div class="clinic-card-soft p-4 h-100">
                    <small class="text-muted">Leídas</small>
                    <h3 class="clinic-title mb-0">@Model.Count(x => x.Leida)</h3>
                </div>
            </div>
        </div>

        <div class="clinic-table-card">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
                <div>
                    <h5 class="clinic-title mb-0">Listado de notificaciones</h5>
                    <small class="text-muted">
                        Las notificaciones más recientes aparecen primero.
                    </small>
                </div>

                <span class="clinic-badge">
                    @(soloPendientes ? "Pendientes" : "Todas")
                </span>
            </div>

            @if (!Model.Any())
            {
                <div class="clinic-empty-state">
                    No hay notificaciones para mostrar.
                </div>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var notificacion in Model)
                    {
                        <div class="list-group-item border-0 px-0">
                            <div class="clinic-card-soft p-3 @(notificacion.Leida ? "opacity-75" : "")">
                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">

                                    <div>
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <h6 class="clinic-title mb-0">
                                                @notificacion.Titulo
                                            </h6>

                                            @if (notificacion.Leida)
                                            {
                                                <span class="badge bg-secondary">
                                                    Leída
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">
                                                    Pendiente
                                                </span>
                                            }
                                        </div>

                                        <p class="clinic-subtitle mb-2">
                                            @notificacion.Mensaje
                                        </p>

                                        <small class="text-muted">
                                            @notificacion.FechaCreacion.ToString("dd/MM/yyyy HH:mm")
                                        </small>
                                    </div>

                                    @if (!notificacion.Leida)
                                    {
                                        <form method="post"
                                              asp-controller="Notificaciones"
                                              asp-action="MarcarLeida">
                                            <input type="hidden" name="notificacionId" value="@notificacion.Id" />

                                            <button type="submit" class="btn btn-sm btn-outline-primary">
                                                Marcar como leída
                                            </button>
                                        </form>
                                    }

                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>