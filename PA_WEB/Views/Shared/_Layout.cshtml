@using Microsoft.AspNetCore.Http

@{
    var nombreUsuario = Context.Session.GetString("NombreUsuario");
    var correoUsuario = Context.Session.GetString("CorreoUsuario");
}

<!doctype html>

<html lang="es"
      class="layout-menu-fixed layout-wide"
      data-assets-path="../assets/"
      data-template="vertical-menu-template-free">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0" />

    <title>@(ViewData["Title"] ?? "Clínica SM")</title>

    <meta name="description" content="Sistema de citas médicas Clínica SM" />

    <link rel="icon" type="image/x-icon" href="../assets/img/favicon/favicon.ico" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet" href="~/css/iconify-icons.css" />
    <link rel="stylesheet" href="~/css/core.css" />
    <link rel="stylesheet" href="~/css/perfect-scrollbar.css" />
    <link rel="stylesheet" href="~/css/pages/page-auth.css" />

    <script src="~/js/helpers.js"></script>
    <script src="~/js/config.js"></script>
</head>

<body>
    <div class="layout-wrapper layout-content-navbar">
        <div class="layout-container">

            <!-- Menu -->
            <aside id="layout-menu" class="layout-menu menu-vertical menu bg-white shadow-sm compact-menu">
                <div class="app-brand demo">
                    <a asp-action="Inicio" asp-controller="Home" class="app-brand-link d-flex align-items-center">
                        <div class="app-brand-logo demo rounded text-white d-flex align-items-center justify-content-center"
                             style="width:40px;height:40px;font-weight:700;background:linear-gradient(90deg,#6c63ff,#5db0ff);">
                            SM
                        </div>

                        <span class="app-brand-text demo menu-text fw-bold ms-2">
                            Clínica SM
                        </span>
                    </a>

                    <a href="javascript:void(0);" class="layout-menu-toggle menu-link text-large ms-auto">
                        <i class="bx bx-chevron-left d-block d-xl-none align-middle"></i>
                    </a>
                </div>

                <div class="menu-divider mt-0"></div>

                <div class="menu-inner-shadow"></div>

                <ul class="menu-inner py-1">

                    <li class="menu-header small text-uppercase">
                        <span class="menu-header-text">Principal</span>
                    </li>

                    <li class="menu-item">
                        <a asp-action="Inicio" asp-controller="Home" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-home-smile"></i>
                            <div class="text-truncate">Inicio</div>
                        </a>
                    </li>

                    <li class="menu-item">
                        <a asp-action="Index" asp-controller="Citas" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-calendar"></i>
                            <div class="text-truncate">Mis citas</div>
                        </a>
                    </li>

                    <li class="menu-header small text-uppercase">
                        <span class="menu-header-text">Cuenta</span>
                    </li>

                    <li class="menu-item">
                        <a asp-action="ActualizarContrasena" asp-controller="Home" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-lock"></i>
                            <div class="text-truncate">Actualizar contraseña</div>
                        </a>
                    </li>

                    <li class="menu-item">
                        <a asp-action="Salir" asp-controller="Home" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-log-out"></i>
                            <div class="text-truncate">Cerrar sesión</div>
                        </a>
                    </li>

                </ul>
            </aside>
            <!-- / Menu -->

            <div class="layout-page">

                <!-- Navbar -->
                <nav class="layout-navbar container-fluid navbar-detached navbar navbar-expand-xl align-items-center bg-navbar-theme"
                     id="layout-navbar">

                    <div class="layout-menu-toggle navbar-nav align-items-xl-center me-4 me-xl-0 d-xl-none">
                        <a class="nav-item nav-link px-0 me-xl-6" href="javascript:void(0)">
                            <i class="icon-base bx bx-menu icon-md"></i>
                        </a>
                    </div>

                    <div class="navbar-nav-right d-flex align-items-center justify-content-between w-100" id="navbar-collapse">

                        <div class="navbar-nav align-items-center">
                            <span class="text-muted small">
                                Sistema de Citas Médicas
                            </span>
                        </div>

                        <div class="navbar-nav align-items-center">
                            @if (!string.IsNullOrWhiteSpace(nombreUsuario))
                            {
                                <div class="text-end d-none d-md-block">
                                    <div class="fw-semibold">
                                        @nombreUsuario
                                    </div>

                                    <small class="text-muted">
                                        @correoUsuario
                                    </small>
                                </div>
                            }
                        </div>

                    </div>
                </nav>
                <!-- / Navbar -->

                <div class="content-wrapper">

                    <div class="container-fluid flex-grow-1 container-p-y">
                        <div class="layout-demo-wrapper">
                            @RenderBody()
                        </div>
                    </div>

                    <footer class="content-footer footer bg-footer-theme">
                        <div class="container-fluid">
                            <div class="footer-container d-flex align-items-center justify-content-center py-4">
                                <div class="footer clearfix mb-0 text-muted text-center">
                                    <p class="mb-0">
                                        @DateTime.Now.Year &copy; Clínica SM | Proyecto Web - PA
                                    </p>
                                </div>
                            </div>
                        </div>
                    </footer>

                    <div class="content-backdrop fade"></div>
                </div>

            </div>

        </div>

        <div class="layout-overlay layout-menu-toggle"></div>
    </div>

    <script src="~/lib/jquery/dist/jquery.js"></script>
    <script src="~/js/popper.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.min.js"></script>
    <script src="~/js/perfect-scrollbar.js"></script>
    <script src="~/js/menu.js"></script>
    <script src="~/js/main.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>