<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PA_WEB</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PA_WEB.styles.css" asp-append-version="true" />
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet" href="~/css/iconify-icons.css" />
    <link rel="stylesheet" href="~/css/core.css" />
    <link rel="stylesheet" href="~/css/perfect-scrollbar.css" />
    <link rel="stylesheet" href="~/css/pages/page-auth.css" />
    <script src="~/js/helpers.js"></script>
    <script src="~/js/config.js"></script>
</head>
<body>
    <div id="auth">
        <div class="auth-logo">
            <a asp-action="Index" asp-controller="Home">
                @* <img src="~/images/logo-fidelitas.png" alt="Logo"> *@
            </a>
        </div>

        @RenderBody()
    </div>

    <!-- Footer -->
    <footer class="content-footer footer bg-footer-theme">
        <div class="container-fluid">
            <div class="footer-container d-flex align-items-center justify-content-between py-4 flex-column">
                <div class="footer clearfix mb-0 text-muted">
                    <p>
                        @DateTime.Now.Year &copy; Sneat by
                        <a href="https://themeselection.com" target="_blank" class="footer-link">ThemeSelection</a> | Proyecto Web - PA
                    </p>
                </div>
            </div>
        </div>
    </footer>
    <!-- / Footer -->
    <!-- Core JS -->

    <script src="~/lib/jquery/dist/jquery.js"></script>
    <script src="~/js/popper.js"></script>
    <script src="~/lib//bootstrap/dist/js/bootstrap.min.js"></script>
    <script src="~/js/perfect-scrollbar.js"></script>
    <script src="~/js/menu.js"></script>
    <script src="~/js/main.js"></script>

    <!-- Page JS -->
    <!-- Place this tag before closing body tag for github widget button. -->
    <script async defer src="https://buttons.github.io/buttons.js"></script>
</body>
</html>

