<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@(ViewData["Title"] ?? "Clínica SM")</title>

    <meta name="description" content="Sistema de citas médicas Clínica SM" />

    <link rel="icon" type="image/x-icon" href="../assets/img/favicon/favicon.ico" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/iconify-icons.css" />
    <link rel="stylesheet" href="~/css/core.css" />
    <link rel="stylesheet" href="~/css/perfect-scrollbar.css" />
    <link rel="stylesheet" href="~/css/pages/page-auth.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PA_WEB.styles.css" asp-append-version="true" />

    <script src="~/js/helpers.js"></script>
    <script src="~/js/config.js"></script>
</head>

<body>
    <main class="auth-page">
        <div>
            <div class="auth-brand">
                Clínica SM
            </div>

            @RenderBody()
        </div>
    </main>

    <footer class="content-footer footer bg-footer-theme">
        <div class="container-fluid">
            <div class="footer-container d-flex align-items-center justify-content-center py-3">
                <div class="footer clearfix mb-0 text-muted text-center">
                    <p class="mb-0">
                        @DateTime.Now.Year &copy; Clínica SM | Sistema de Citas Médicas
                    </p>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.js"></script>
    <script src="~/js/popper.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.min.js"></script>
    <script src="~/js/perfect-scrollbar.js"></script>
    <script src="~/js/menu.js"></script>
    <script src="~/js/main.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>