@model PA_WEB.Models.ActualizarContrasenaModel

@{
    ViewData["Title"] = "Actualizar Contraseña";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">

                <h4 class="mb-1">Actualizar contraseña</h4>

                <p class="mb-4 text-muted">
                    Ingrese una nueva contraseña para su cuenta.
                </p>

                @if (TempData["Mensaje"] != null)
                {
                    <div class="alert alert-info" role="alert">
                        @TempData["Mensaje"]
                    </div>
                }

                @if (ViewBag.Mensaje != null)
                {
                    <div class="alert alert-danger" role="alert">
                        @ViewBag.Mensaje
                    </div>
                }

                <form asp-action="ActualizarContrasena" asp-controller="Home" method="post">

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="ContrasenaNueva" class="form-label">Nueva contraseña</label>

                        <div class="input-group">
                            <span class="input-group-text bg-white">
                                <i class="bx bx-lock"></i>
                            </span>

                            <input asp-for="ContrasenaNueva"
                                   type="password"
                                   class="form-control"
                                   placeholder="Ingrese la nueva contraseña" />
                        </div>

                        <span asp-validation-for="ContrasenaNueva" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmarContrasenaNueva" class="form-label">Confirmar nueva contraseña</label>

                        <div class="input-group">
                            <span class="input-group-text bg-white">
                                <i class="bx bx-lock-alt"></i>
                            </span>

                            <input asp-for="ConfirmarContrasenaNueva"
                                   type="password"
                                   class="form-control"
                                   placeholder="Confirme la nueva contraseña" />
                        </div>

                        <span asp-validation-for="ConfirmarContrasenaNueva" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2 flex-wrap">
                        <button class="btn btn-primary" type="submit">
                            Actualizar contraseña
                        </button>

                        <a class="btn btn-outline-secondary" asp-action="Inicio" asp-controller="Home">
                            Volver
                        </a>
                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}