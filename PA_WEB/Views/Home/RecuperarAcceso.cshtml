@model RecuperarAccesoModel

@{
    Layout = "_LayoutExterno";
    ViewData["Title"] = "Recuperar Acceso";
}

<div class="container-xxl">
    <div class="authentication-wrapper authentication-basic container-p-y">
        <div class="authentication-inner">

            <div class="card px-sm-6 px-0 shadow-sm">
                <div class="card-body">

                    <h4 class="mb-1">Recuperar acceso</h4>

                    <p class="mb-6 text-muted">
                        Ingrese el correo electrónico registrado en el sistema para recuperar el acceso a su cuenta.
                    </p>

                    @if (ViewBag.Mensaje != null)
                    {
                        <div class="alert alert-danger" role="alert">
                            @ViewBag.Mensaje
                        </div>
                    }

                    <form asp-action="RecuperarAcceso" asp-controller="Home" method="post">

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="CorreoElectronico" class="form-label">Correo Electrónico</label>

                            <div class="input-group">
                                <span class="input-group-text bg-white">
                                    <i class="bx bx-envelope"></i>
                                </span>

                                <input type="text"
                                       class="form-control"
                                       asp-for="CorreoElectronico"
                                       placeholder="correo@ejemplo.com"
                                       autofocus />
                            </div>

                            <span asp-validation-for="CorreoElectronico" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <button class="btn btn-primary d-grid w-100" type="submit">
                                Recuperar acceso
                            </button>
                        </div>

                    </form>

                    <p class="text-center small text-muted">
                        ¿Recordó su contraseña?
                        <a asp-action="Index" asp-controller="Home">Iniciar sesión</a>
                    </p>

                    <p class="text-center small text-muted mb-0">
                        ¿No tiene cuenta?
                        <a asp-action="RegistrarUsuario" asp-controller="Home">Regístrese</a>
                    </p>

                </div>
            </div>

        </div>
    </div>
</div>