@model List<PA_WEB.Models.EspecialidadModel>

@{
    ViewData["Title"] = "Inicio";
    var especialidades = Model ?? new List<PA_WEB.Models.EspecialidadModel>();
}

<section class="py-5 bg-hero">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-10">

                @if (TempData["Mensaje"] != null)
                {
                    <div class="alert alert-info shadow-sm mb-4" role="alert">
                        @TempData["Mensaje"]
                    </div>
                }

                <div class="row g-4 align-items-center">

                    <div class="col-lg-7">
                        <div class="card shadow-lg" style="border-radius:14px; overflow:hidden;">
                            <div class="card-header bg-clinic p-4 text-white">
                                <div class="d-flex align-items-center justify-content-between">
                                    <div>
                                        <h3 class="mb-0">Agendar cita médica</h3>
                                        <small class="opacity-75">
                                            Elija la especialidad para ver los profesionales disponibles.
                                        </small>
                                    </div>

                                    <div class="d-none d-md-block text-end">
                                        <div class="fw-bold">Clínica SM</div>
                                        <small>Atención de calidad</small>
                                    </div>
                                </div>
                            </div>

                            <div class="card-body p-4">

                                @if (especialidades.Count == 0)
                                {
                                    <div class="alert alert-warning" role="alert">
                                        No hay especialidades disponibles en este momento. Verifique que el API esté ejecutándose correctamente.
                                    </div>
                                }

                                <form method="get" asp-controller="Citas" asp-action="Profesionales" class="row g-3">

                                    <div class="col-12">
                                        <label class="form-label">Especialidad</label>

                                        <div class="input-group">
                                            <span class="input-group-text bg-white">
                                                <i class="bx bx-briefcase"></i>
                                            </span>

                                            <select name="especialidadId" class="form-select" required>
                                                <option value="">Seleccione una especialidad</option>

                                                @foreach (var especialidad in especialidades)
                                                {
                                                    <option value="@especialidad.Id">@especialidad.Nombre</option>
                                                }
                                            </select>
                                        </div>
                                    </div>

                                    <div class="col-12 d-flex justify-content-between align-items-center flex-wrap gap-3">
                                        <div class="text-muted small">
                                            Protegemos sus datos y cumplimos con la privacidad.
                                        </div>

                                        <button type="submit" class="btn btn-primary btn-lg" disabled="@(especialidades.Count == 0)">
                                            Ver profesionales
                                        </button>
                                    </div>

                                </form>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-5">
                        <div class="card border-0 shadow-sm" style="border-radius:12px;">
                            <div class="card-body p-4">

                                <div class="d-flex align-items-start gap-3 mb-3">
                                    <div class="icon bg-soft p-3 rounded-3">
                                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <rect x="2" y="3" width="20" height="18" rx="2" fill="#5db0ff" />
                                            <path d="M12 7v10" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                                            <path d="M8 11h8" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                                        </svg>
                                    </div>

                                    <div>
                                        <h5 class="mb-1">Información rápida</h5>
                                        <p class="text-muted small mb-0">
                                            Encuentre horarios, contacto y opciones de especialistas de manera rápida.
                                        </p>
                                    </div>
                                </div>

                                <div class="p-3 rounded-3 bg-primary text-white mb-3">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <small>Horario</small>
                                            <div class="fw-bold">Lun - Vie · 8:00 - 18:00</div>
                                        </div>

                                        <div class="text-end">
                                            <small>Tel.</small>
                                            <div class="fw-bold">(555) 123-4567</div>
                                        </div>
                                    </div>
                                </div>

                                <ul class="list-unstyled mb-3">
                                    <li class="mb-2">
                                        <i class="bx bx-check-circle text-success me-2"></i>
                                        Confirmación por email
                                    </li>

                                    <li class="mb-2">
                                        <i class="bx bx-check-circle text-success me-2"></i>
                                        Recordatorios SMS
                                    </li>

                                    <li class="mb-2">
                                        <i class="bx bx-check-circle text-success me-2"></i>
                                        Profesionales certificados
                                    </li>
                                </ul>

                                <div class="d-grid gap-2">
                                    <a class="btn btn-outline-primary" asp-controller="Citas" asp-action="Index">
                                        Ver mis citas
                                    </a>

                                    <a class="btn btn-light border" asp-controller="Home" asp-action="ActualizarContrasena">
                                        Actualizar contraseña
                                    </a>
                                </div>

                                <div class="mt-3 text-center text-muted small">
                                    Diseño moderno y confiable — Clínica SM
                                </div>

                            </div>
                        </div>
                    </div>

                </div>

            </div>
        </div>
    </div>
</section>