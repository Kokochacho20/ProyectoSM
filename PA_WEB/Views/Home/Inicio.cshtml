@model List<PA_WEB.Models.EspecialidadModel>

@{
    ViewData["Title"] = "Inicio";
    var especialidades = Model ?? new List<PA_WEB.Models.EspecialidadModel>();
}

<section class="bg-hero">
    <div class="container-fluid px-0">

        <div class="row g-4 mb-4">
            <div class="col-12">
                <div class="home-welcome-card">
                    <div class="row align-items-center">
                        <div class="col-lg-8">
                            <span class="home-section-badge">
                                <i class="bx bx-heart"></i>
                                Bienvenido
                            </span>

                            <h3>Gestione sus citas médicas de forma rápida y segura</h3>

                            <p>
                                Seleccione una especialidad, consulte los profesionales disponibles
                                y administre sus citas desde un solo lugar.
                            </p>
                        </div>

                        <div class="col-lg-4 text-lg-end mt-4 mt-lg-0">
                            <div class="fw-semibold fs-5">Clínica SM</div>
                            <div class="opacity-75">Atención confiable y organizada</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-info shadow-sm mb-4" role="alert">
                @TempData["Mensaje"]
            </div>
        }

        <div class="row g-4 align-items-stretch">
            <div class="col-lg-7">
                <div class="home-action-card">
                    <span class="home-section-badge">
                        <i class="bx bx-calendar-plus"></i>
                        Agendamiento
                    </span>

                    <h4 class="mb-2">Agendar cita médica</h4>
                    <p class="clinic-subtitle mb-4">
                        Elija la especialidad para ver los profesionales disponibles y continuar con su cita.
                    </p>

                    <form method="get" asp-controller="Citas" asp-action="Profesionales" class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-semibold">Especialidad</label>

                            <div class="input-group">
                                <span class="input-group-text bg-white">
                                    <i class="bx bx-briefcase-alt-2"></i>
                                </span>

                                <select name="especialidadId" class="form-select" required>
                                    <option value="">Seleccione una especialidad</option>
                                    @foreach (var especialidad in especialidades)
                                    {
                                        <option value="@especialidad.Id">@especialidad.Nombre</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                                <small class="text-muted">
                                    Protegemos sus datos y mantenemos un proceso seguro para el agendamiento.
                                </small>

                                <button type="submit" class="btn btn-primary px-4">
                                    Ver profesionales
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="home-action-card">
                    <span class="home-section-badge">
                        <i class="bx bx-info-circle"></i>
                        Información rápida
                    </span>

                    <h4 class="mb-2">Accesos y datos útiles</h4>
                    <p class="clinic-subtitle mb-4">
                        Consulte información general y vaya rápidamente a las opciones principales del sistema.
                    </p>

                    <div class="clinic-info-box mb-4">
                        <div class="row">
                            <div class="col-6">
                                <small class="opacity-75">Horario</small>
                                <div class="fw-bold fs-5">Lun - Vie</div>
                                <div class="fw-semibold">8:00 AM - 6:00 PM</div>
                            </div>
                            <div class="col-6 text-end">
                                <small class="opacity-75">Contacto</small>
                                <div class="fw-bold fs-5">(555) 123-4567</div>
                                <div class="fw-semibold">Clínica SM</div>
                            </div>
                        </div>
                    </div>

                    <ul class="home-feature-list mb-4">
                        <li>
                            <i class="bx bx-check-circle"></i>
                            <span>Consulta y seguimiento de citas desde una sola plataforma.</span>
                        </li>
                        <li>
                            <i class="bx bx-check-circle"></i>
                            <span>Acceso seguro para usuarios autenticados.</span>
                        </li>
                        <li>
                            <i class="bx bx-check-circle"></i>
                            <span>Gestión rápida de actualización de contraseña y recuperación de acceso.</span>
                        </li>
                    </ul>

                    <div class="d-grid gap-2">
                        <a class="btn btn-outline-primary quick-link-btn"
                           asp-controller="Citas"
                           asp-action="Index">
                            Ver mis citas
                        </a>

                        <a class="btn btn-primary quick-link-btn"
                           asp-controller="Home"
                           asp-action="ActualizarContrasena">
                            Actualizar contraseña
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>